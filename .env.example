# Copy to .env.local for local overrides (.env is tracked and used by production builds).

# Django API base URL, no trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Google Identity Services client ID (public).
VITE_GOOGLE_CLIENT_ID=
# Interview Prep live copilot sidecar WebSocket base URL, no trailing slash.
# Local: ws://127.0.0.1:8001   Production: wss://<copilot service host>
VITE_COPILOT_WS_URL=ws://127.0.0.1:8001
